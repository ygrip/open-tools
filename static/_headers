# Crawlers should receive fresh sitemap metadata with an explicit document type.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

# The release probe and worker script are mutable aliases. Never make browsers
# or intermediary caches hold a previous deployment's update metadata.
/_app/version.json
  Cache-Control: no-store
/service-worker.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, max-age=0, must-revalidate

# Cache busting: every path below is content-addressed (hash in the file name),
# so a changed file always gets a new URL and old URLs can be cached for a year.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
/bundles/*
  Cache-Control: public, max-age=31536000, immutable
/icons/tools/*
  Cache-Control: public, max-age=31536000, immutable
