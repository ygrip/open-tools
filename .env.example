# Public, canonical production HTTPS origin. No path, query, credentials or fragment.
# Unset: SEO generation uses the wrangler.jsonc custom domain (production, indexable sitemap).
# Set to an empty value for local/PR previews: generated SEO is deliberately noindex.
# Pass this variable to npm run build (CI/hosting environment); Node scripts do not load .env automatically.
PUBLIC_SITE_URL=
