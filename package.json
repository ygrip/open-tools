{
  "name": "trick-it",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run registry:sync && npm run seo:generate",
    "dev": "vite dev",
    "build": "npm run registry:sync && npm run seo:generate && vite build && node scripts/export-error-page.mjs",
    "preview": "vite preview",
    "check": "npm run i18n:compile && npm run seo:generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "registry:sync": "node scripts/sync-tools.mjs",
    "seo:generate": "node scripts/generate-seo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "performance:check": "node scripts/check-performance.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "i18n:compile": "paraglide-js compile --project ./project.inlang"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@inlang/paraglide-js": "^2.29.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0"
  }
}
